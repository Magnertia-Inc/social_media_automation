# ==============================================================================
# MARKETING WORKFLOW - CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and fill in your credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & AUTOMATION (N8N)
# ------------------------------------------------------------------------------
PORT=8080
N8N_URL=http://localhost:5678

# ------------------------------------------------------------------------------
# 2. SUPABASE (Database & Banner Storage)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_or_anon_key
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=marketing-banners

# ------------------------------------------------------------------------------
# 3. LINKEDIN CREDENTIALS (OAuth 2.0 & Publishing API)
# ------------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_TOKEN=your_linkedin_oauth_access_token
LINKEDIN_ACCESS_TOKEN=your_linkedin_oauth_access_token
LINKEDIN_REFRESH_TOKEN=your_linkedin_refresh_token
LINKEDIN_AUTHOR=urn:li:person:your_person_id
LINKEDIN_ORGANIZATION_URN=urn:li:organization:your_org_id
LINKEDIN_REDIRECT_URI=http://localhost:8080/callback/linkedin

# ------------------------------------------------------------------------------
# 4. FACEBOOK CREDENTIALS (Meta Graph API & Pages)
# ------------------------------------------------------------------------------
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_TOKEN=your_facebook_page_access_token
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FACEBOOK_USER_ACCESS_TOKEN=your_facebook_user_access_token

# ------------------------------------------------------------------------------
# 5. INSTAGRAM CREDENTIALS (Instagram Graph API & Business)
# ------------------------------------------------------------------------------
INSTAGRAM_ID=your_instagram_business_account_id
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_access_token
INSTAGRAM_SECONDARY_ACCESS_TOKEN=your_secondary_instagram_graph_access_token
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_USERNAME=your_instagram_handle
INSTAGRAM_PASSWORD=your_instagram_account_password

# ------------------------------------------------------------------------------
# 6. YOUTUBE & GOOGLE CLOUD CREDENTIALS (Data API v3 & OAuth 2.0)
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CHANNEL_ID=your_youtube_channel_id
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token
GMAIL_REFRESH_TOKEN=your_gmail_oauth_refresh_token
YOUTUBE_CLIENT_ID=your_youtube_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_oauth_client_secret
YOUTUBE_ACCESS_TOKEN=your_youtube_access_token
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token
YOUTUBE_REDIRECT_URI=http://localhost:8080/callback/youtube

# ------------------------------------------------------------------------------
# 7. X (TWITTER) CREDENTIALS (API v2 & OAuth 1.0a User Context)
# ------------------------------------------------------------------------------
X_API_KEY=your_x_consumer_key
X_API_SECRET=your_x_consumer_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret

# ------------------------------------------------------------------------------
# 8. THREADS CREDENTIALS (Meta Threads API & Publishing)
# ------------------------------------------------------------------------------
THREADS_APP_ID=your_threads_app_id
THREADS_APP_SECRET=your_threads_app_secret
THREADS_REDIRECT_URI=https://your-domain.railway.app/callback/threads
THREADS_ACCESS_TOKEN=your_threads_access_token
THREADS_USER_ID=your_threads_user_id
THREADS_USERNAME=your_threads_username

# ------------------------------------------------------------------------------
# 9. PINTEREST CREDENTIALS (API v5 & OAuth 2.0)
# ------------------------------------------------------------------------------
PINTEREST_APP_ID=your_pinterest_app_id
PINTEREST_APP_SECRET=your_pinterest_app_secret
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token
PINTEREST_REFRESH_TOKEN=your_pinterest_refresh_token
PINTEREST_BOARD_ID=your_pinterest_board_id
PINTEREST_REDIRECT_URI=https://your-domain.railway.app/callback/pinterest

# ------------------------------------------------------------------------------
# 10. AI ENGINE (Groq LLM for Content, Hooks & Summaries)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_primary_groq_api_key
GROQ_SECONDARY_API_KEY=your_backup_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 11. BRANDING & DEFAULT IDENTIFIERS
# ------------------------------------------------------------------------------
DEFAULT_BUSINESS_NAME=Your Business Name
DEFAULT_HANDLE=@yourhandle
